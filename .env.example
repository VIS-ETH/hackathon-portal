POSTGRES_USER=portal
POSTGRES_PASSWORD=password
POSTGRES_DB=portal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

PORTAL__SERVER__IP=0.0.0.0
# Browser origins allowed to call the API (CORS) and to send writes; writes from other origins get 403. Must match
# exactly (scheme, host, port, no trailing slash). Here: the dev frontend and the API's own Swagger UI.
PORTAL__SERVER__ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# Target of the frontend's logout links (hidden if unset). Clears the oauth2-proxy cookie and redirects to
# viscon.ethz.ch (must be allowed via --whitelist-domain on oauth2-proxy).
# PORTAL__SERVER__LOGOUT_URL=https://auth.hackathon.ethz.ch/oauth2/sign_out?rd=https%3A%2F%2Fviscon.ethz.ch

PORTAL__AUTH__STRATEGY=Mock

PORTAL__POSTGRES__URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
# PORTAL__POSTGRES__MAX_CONNECTIONS=30

PORTAL__S3__ENDPOINT=http://localhost:9000
PORTAL__S3__BUCKET=portal
PORTAL__S3__REGION=local
PORTAL__S3__PATH_STYLE=true
PORTAL__S3__ACCESS_KEY=portal-dev
PORTAL__S3__SECRET_KEY=portal-dev-secret

PORTAL__DISCORD__CLIENT_ID=
PORTAL__DISCORD__CLIENT_SECRET=
PORTAL__DISCORD__BOT_TOKEN=

# Must be a 64-character hex string (32 bytes)
PORTAL__CRYPTO__KEY=


# LiteLLM proxy used to generate team AI API keys; also served to the frontend to show key usage (disabled if unset).
# PORTAL__LITELLM__URL=https://llm.hackathon.ethz.ch
